table FactSales
	lineageTag: 77181f70-ca8b-4590-b24c-dcb478f1e31a

	measure 'Total Sales Revenue' =
			
			SUM(FactSales[SalesAmount])
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		lineageTag: fc4bc099-2c0f-4c7b-b7a3-354820a19a54

		annotation PBI_FormatHint = {"currencyCulture":"st-ZA"}

	measure 'Total Orders' =
			
			DISTINCTCOUNT(FactSales[OrderID])
		formatString: 0
		lineageTag: f8325177-8552-465e-9546-b2c06b63e907

	measure 'Average Order Value' =
			
			DIVIDE(
			    [Total Sales Revenue],
			    [Total Orders]
			)
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		lineageTag: 71442713-be32-49be-9b2f-f1f9f70e7724

		annotation PBI_FormatHint = {"currencyCulture":"st-ZA"}

	measure 'Total Quantity Sold' =
			
			SUM(FactSales[QuantitySold])
		formatString: #,0.##
		lineageTag: 165e8879-77d9-4610-b58c-80e6dd431d32

